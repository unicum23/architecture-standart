@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(user, "Клиент банка", "Физическое лицо — потребитель банковских услуг")
Person(manager, "Оператор колл-центра", "Сотрудник, консультирующий клиентов")

System_Ext(call_center, "Колл-центр", "Внешняя система приема и обработки клиентских обращений")
System(sftp, "SFTP-сервер", "Защищённый сервер обмена файлами со ставками по депозитам")
System(deposits, "Депозитная система", "Сервис управления депозитными продуктами и ставками")

Rel(user, call_center, "Обращается за консультацией по депозитным ставкам", "Телефонный канал")
Rel(manager, call_center, "Обрабатывает входящие обращения", "Телефонный канал")
Rel(manager, sftp, "Получает актуальные ставки по депозитам", "SFTP")
Rel(deposits, sftp, "Выгружает ставки для колл-центра", "SFTP")
@enduml